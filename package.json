{
  "name": "mob-timer-bot",
  "version": "v0.0.6",
  "description": "",
  "private": true,
  "type": "module",
  "main": "src/Code.ts",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "deploy": "npm run build && clasp push -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --fix src/**/*.ts __tests__/**/*.ts",
    "lint:check": "eslint src/**/*.ts __tests__/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2tzumi/mob-timer-bot.git"
  },
  "author": "k2tzumi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/k2tzumi/mob-timer-bot/issues"
  },
  "homepage": "https://github.com/k2tzumi/mob-timer-bot#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.1.3",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/google-apps-script": "^1.0.83",
    "@types/google-apps-script-oauth2": "^38.0.0",
    "@types/jest": "^29.5.0",
    "apps-script-jobqueue": "github:k2tzumi/apps-script-jobqueue#v0.1.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "rollup": "^4.56.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
